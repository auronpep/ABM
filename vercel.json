{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/checkout/success", "destination": "/checkout.html?purchase=success" },
    { "source": "/diagnostic", "destination": "/index.html" },
    { "source": "/pricing", "destination": "/index.html" },
    { "source": "/sign-in", "destination": "/index.html" },
    { "source": "/sign-up", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" }
  ]
}
